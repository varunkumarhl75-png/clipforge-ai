# Environment Configuration

# Application Mode
DEMO_MODE=true

# Backend - local development
BACKEND_URL=http://localhost:8001
UPLOAD_MAX_SIZE=5000000000

# Database
DATABASE_URL=sqlite:///./app/db/clipforge.db

# Frontend - local development
# For production on Render, set NEXT_PUBLIC_API_URL in Render Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8001

# Optional server-side AI providers
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
