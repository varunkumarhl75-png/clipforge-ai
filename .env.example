# Environment Configuration

# Application Mode
DEMO_MODE=true

# Backend
BACKEND_URL=http://localhost:8000
UPLOAD_MAX_SIZE=5000000000

# Database
DATABASE_URL=sqlite:///./app/db/clipforge.db

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional server-side AI providers
